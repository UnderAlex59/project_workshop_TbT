# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=investpro
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TTL=360

# Security
SECRET_KEY=change_me_to_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (use "*" to allow all)
# Include your deployed frontend origin (with port) to avoid CORS issues when the app is accessed directly
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# OpenRouter / LLM
OPENROUTER_API_KEY=put_real_key_here
# Optional additional keys to rotate on rate limits
# OPENROUTER_API_KEY_2=
MODEL=gpt-4o-mini
MODEL_ANALYSIS=gpt-4o-mini

# Frontend build
VITE_API_URL=/api
VITE_API_BASE_URL=/api
